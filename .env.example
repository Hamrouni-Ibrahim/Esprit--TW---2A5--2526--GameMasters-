# Application
APP_ENV=development
APP_NAME="Game Masters"
SMTP_DEBUG=0

# SMTP (emails : vérification, reset mot de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application
SMTP_FROM_EMAIL=noreply@gamemasters.com
SMTP_FROM_NAME="Game Masters"

# Base de données (optionnel si config/database.php est utilisé)
DB_HOST=localhost
DB_NAME=game_masters
DB_USER=root
DB_PASS=

# Google reCAPTCHA (optionnel)
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=votre-site-key
RECAPTCHA_SECRET_KEY=votre-secret-key

# OpenAI (optionnel — résumés automatiques des projets)
OPENAI_API_KEY=
